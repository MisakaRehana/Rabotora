<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyTitle>Rabotora Desktop Player</AssemblyTitle>
        <Version>0.1.0</Version>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Rabotora.Core\Rabotora.Core.csproj" />
      <!--
          Referenced on purpose even though no type of it is used in source: Rabotora.Core resolves
          the platform implementations through Type.GetType("..., Rabotora.Interop.Win32"), so the
          assembly has to be present next to the player for the platform detect to succeed.
      -->
      <ProjectReference Include="..\Rabotora.Interop.Win32\Rabotora.Interop.Win32.csproj" />
    </ItemGroup>

</Project>
