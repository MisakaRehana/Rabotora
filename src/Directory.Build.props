<Project>

    <!--
        Generates a BuildInfo class holding the time of the build into the intermediate (obj) directory
        and feeds it to the compiler, so that every project below src\ knows when it was built.

        BuildInfoNamespace overrides the namespace of the generated class. It defaults to the project
        name rather than RootNamespace, because Rabotora.Interop.Win32 sets RootNamespace to
        Rabotora.Core and both projects would then generate the very same Rabotora.Core.BuildInfo type.
    -->
    <Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile;CoreCompile" Condition="'$(Configuration)' == 'Release'">
        <PropertyGroup>
            <BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoFile>
            <_BuildInfoNs Condition="'$(BuildInfoNamespace)' != ''">$(BuildInfoNamespace)</_BuildInfoNs>
            <_BuildInfoNs Condition="'$(_BuildInfoNs)' == ''">$(MSBuildProjectName)</_BuildInfoNs>
            <_BuildTimestamp>$([System.DateTimeOffset]::UtcNow.ToString('yyyy-MM-dd HH:mm:ss'))</_BuildTimestamp>
            <_BuildTimestampIso>$([System.DateTimeOffset]::UtcNow.ToString('o'))</_BuildTimestampIso>
            <!-- An escaped space (%20). MSBuild trims literal leading whitespace from item specs, this survives the trim. -->
            <_BuildInfoIndent>%20%20%20%20</_BuildInfoIndent>
        </PropertyGroup>

        <!--
            One item per generated line. Two rules for the text of an Include:
              * a literal semicolon must be written %3B, or MSBuild reads it as an item separator and
                splits that one generated line into two;
              * a literal space at the very start of the line must be written %20, for the same reason
                (a truly empty Include is rejected, so a blank output line is %20).
        -->
        <ItemGroup>
            <_BuildInfoLine Include="// &lt;auto-generated/&gt;" />
            <_BuildInfoLine Include="//     Generated by the GenerateBuildInfo target in src/Directory.Build.props." />
            <_BuildInfoLine Include="//     Rewritten on every build. Do not edit." />
            <_BuildInfoLine Include="%20" />
            <_BuildInfoLine Include="namespace $(_BuildInfoNs)%3B" />
            <_BuildInfoLine Include="%20" />
            <_BuildInfoLine Include="/// &lt;summary&gt;Build metadata for $(AssemblyName).&lt;/summary&gt;" />
            <_BuildInfoLine Include="public static class BuildInfo" />
            <_BuildInfoLine Include="{" />
            <_BuildInfoLine Include="$(_BuildInfoIndent)/// &lt;summary&gt;UTC time at which this assembly was built, formatted as &quot;yyyy-MM-dd HH:mm:ss&quot;.&lt;/summary&gt;" />
            <_BuildInfoLine Include="$(_BuildInfoIndent)public const string Timestamp = &quot;$(_BuildTimestamp)&quot;%3B" />
            <_BuildInfoLine Include="$(_BuildInfoIndent)/// &lt;summary&gt;UTC time at which this assembly was built, in round-trippable ISO 8601 format.&lt;/summary&gt;" />
            <_BuildInfoLine Include="$(_BuildInfoIndent)public const string TimestampIso = &quot;$(_BuildTimestampIso)&quot;%3B" />
            <_BuildInfoLine Include="$(_BuildInfoIndent)/// &lt;summary&gt;Build configuration this assembly was built with, for example Debug or Release.&lt;/summary&gt;" />
            <_BuildInfoLine Include="$(_BuildInfoIndent)public const string Configuration = &quot;$(Configuration)&quot;%3B" />
            <_BuildInfoLine Include="$(_BuildInfoIndent)/// &lt;summary&gt;Target framework this assembly was built for.&lt;/summary&gt;" />
            <_BuildInfoLine Include="$(_BuildInfoIndent)public const string TargetFramework = &quot;$(TargetFramework)&quot;%3B" />
            <_BuildInfoLine Include="}" />
        </ItemGroup>

        <MakeDir Directories="$(IntermediateOutputPath)" />
        <WriteLinesToFile File="$(BuildInfoFile)" Lines="@(_BuildInfoLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />

        <ItemGroup>
            <Compile Include="$(BuildInfoFile)" />
            <FileWrites Include="$(BuildInfoFile)" />
        </ItemGroup>
    </Target>

</Project>
